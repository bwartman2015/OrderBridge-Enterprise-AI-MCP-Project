# Copy this file to .env and adjust values:   cp .env.example .env
# .env is git-ignored, so real passwords never end up in source control.

# --- PostgreSQL (mock ERP) -------------------------------------------------
POSTGRES_USER=orderbridge
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=orderbridge
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Optional: a full SQLAlchemy URL overrides the five values above.
# DATABASE_URL=postgresql+psycopg://orderbridge:change_me_local_only@localhost:5432/orderbridge

# --- Redpanda (Kafka-compatible event broker) ------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
REDPANDA_CONSOLE_PORT=8080

# --- EDI --------------------------------------------------------------------
# Our own interchange ID. Partners address their 850s to this ID (ISA08).
OUR_ISA_ID=ORDERBRIDGE
# T = test, P = production (ISA15 usage indicator on outbound 855/856 files)
EDI_USAGE_INDICATOR=T
EDI_POLL_SECONDS=2

# --- Outbox publisher -------------------------------------------------------
PUBLISHER_POLL_SECONDS=1

# --- MCP server identity ----------------------------------------------------
# Normally passed by Claude Code via `claude mcp add --env ...`; these are fallbacks.
# Roles: viewer (read tools only) or planner (read + write tools).
MCP_ACTOR=brad
MCP_ROLE=planner

# --- Approval CLI -----------------------------------------------------------
# Optional default approver name for scripts/approve.py
# APPROVER_NAME=brad
